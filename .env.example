# Heist Architect — Environment Configuration
#
# Copy this file to .env and edit as needed.
# The .env file is loaded automatically by uvicorn/the shell before starting the backend.
#
# ── Admin / Debug Settings ──────────────────────────────────────────────────
#
# GOD MODE: set to 1 to disable all guard and camera detections.
# The heist crew will never be busted regardless of guard vision.
# Useful for testing objectives, paths, and AI algorithms without pressure.
#
#   HEIST_GOD_MODE=1   → enabled
#   HEIST_GOD_MODE=0   → disabled (default)
#
HEIST_GOD_MODE=0
