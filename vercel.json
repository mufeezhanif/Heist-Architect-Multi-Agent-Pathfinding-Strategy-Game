{
    "buildCommand": "cd frontend && npm run build",
    "outputDirectory": "frontend/dist",
    "functions": {
        "api.py": {
            "runtime": "python3.10"
        }
    },
    "rewrites": [
        {
            "source": "/api/echo",
            "destination": "/echo.py"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api.py/$1"
        },
        {
            "source": "/ws/(.*)",
            "destination": "/api.py/ws/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}